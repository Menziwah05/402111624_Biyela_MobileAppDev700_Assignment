<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textIngredientFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pantry_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ingredient_form_hint"
            android:textColor="@color/pantry_text_secondary" />

        <EditText
            android:id="@+id/inputIngredientName"
            style="@style/Widget.SmartPantry.Input"
            android:hint="@string/ingredient_name"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/inputIngredientQuantity"
            style="@style/Widget.SmartPantry.Input"
            android:hint="@string/quantity"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/inputIngredientUnit"
            style="@style/Widget.SmartPantry.Input"
            android:hint="@string/unit_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/inputIngredientExpiry"
            style="@style/Widget.SmartPantry.Input"
            android:hint="@string/expiry_hint"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonCancelIngredient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/buttonSaveIngredient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/save_ingredient"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
