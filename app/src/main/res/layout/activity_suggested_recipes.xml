<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/pantry_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/suggested_title"
        android:textColor="@color/pantry_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/suggested_subtitle"
        android:textColor="@color/pantry_text_secondary" />

    <TextView
        android:id="@+id/textNoSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="@string/no_suggestions"
        android:textColor="@color/pantry_text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_recipe" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/navPantrySuggestions"
            style="@style/Widget.SmartPantry.NavigationButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nav_pantry" />

        <Button
            android:id="@+id/navSuggestionsActive"
            style="@style/Widget.SmartPantry.NavigationButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nav_suggestions" />

        <Button
            android:id="@+id/navSettingsSuggestions"
            style="@style/Widget.SmartPantry.NavigationButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nav_settings" />
    </LinearLayout>
</LinearLayout>
