<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/pantry_background"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/pantry_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/pantry_subtitle"
        android:textColor="@color/pantry_text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/textPantrySummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/pantry_text"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_pantry" />

    <Button
        android:id="@+id/buttonAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_ingredient"
        android:textAllCaps="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/navPantry"
            style="@style/Widget.SmartPantry.NavigationButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nav_pantry" />

        <Button
            android:id="@+id/navSuggestions"
            style="@style/Widget.SmartPantry.NavigationButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nav_suggestions" />

        <Button
            android:id="@+id/navSettings"
            style="@style/Widget.SmartPantry.NavigationButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nav_settings" />
    </LinearLayout>
</LinearLayout>
