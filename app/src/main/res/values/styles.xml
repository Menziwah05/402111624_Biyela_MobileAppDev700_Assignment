<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartPantry" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/pantry_primary</item>
        <item name="colorPrimaryVariant">@color/pantry_primary_dark</item>
        <item name="colorSecondary">@color/pantry_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorAccent">@color/pantry_accent</item>
        <item name="android:navigationBarColor">@color/pantry_background</item>
        <item name="android:statusBarColor">@color/pantry_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.SmartPantry.NavigationButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pantry_primary</item>
    </style>

    <style name="Widget.SmartPantry.SmallButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.SmartPantry.Input" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/pantry_card</item>
    </style>
</resources>
